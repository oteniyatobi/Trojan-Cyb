{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "flask"
    },
    "ui": {
      "root": "ui",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "ui"
      }
    }
  ]
}
