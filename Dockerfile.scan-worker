FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -L https://github.com/projectdiscovery/nuclei/releases/download/v3.4.10/nuclei_3.4.10_linux_amd64.zip \
        -o /tmp/nuclei.zip \
    && unzip /tmp/nuclei.zip -d /usr/local/bin/ \
    && chmod +x /usr/local/bin/nuclei \
    && rm /tmp/nuclei.zip

RUN curl -L https://github.com/google/osv-scanner/releases/download/v2.7.0/osv-scanner_linux_amd64 \
        -o /usr/local/bin/osv-scanner \
    && chmod +x /usr/local/bin/osv-scanner

COPY backend/scanners/requirements.txt /app/scanners/requirements.txt
RUN pip install --no-cache-dir -r /app/scanners/requirements.txt

COPY backend/scanners/ /app/scanners/

WORKDIR /app
CMD ["python", "-c", "print('scan worker ready')"]
