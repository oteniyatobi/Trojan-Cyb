
# Browser-safe Supabase settings (the VITE_ prefix makes these available to the UI).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend (Flask)
FLASK_DEBUG=0
API_PORT=8000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key
TROJAN_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# Single-install key, mapped to TROJAN_ORGANIZATION_ID. Per-business keys live
# in the Supabase ingest_keys table (SHA-256 hash only).
TROJAN_INGESTION_API_KEY=replace-with-a-long-random-secret

# Wazuh Integration
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=change-me
WAZUH_API_PASSWORD=change-me

# AI Inference Engine
AI_ENGINE_PORT=8001
TF_CPP_MIN_LOG_LEVEL=2

# Groq API (if using)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15
GROQ_MAX_RETRIES=3
# Groq reviews allowed per business per hour; alerts over the limit are stored as rate_limited.
GROQ_REVIEWS_PER_HOUR=100

# Suricata
SURICATA_EVE_LOG=/var/log/suricata/eve.json

# Website scans: the backend starts .github/workflows/scan.yml, which sends
# results back with SCAN_WORKER_SECRET (also saved as a GitHub Actions secret).
GITHUB_DISPATCH_TOKEN=github-token-with-actions-write
SCAN_WORKER_SECRET=replace-with-a-long-random-secret
