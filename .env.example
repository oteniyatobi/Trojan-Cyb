
# Browser-safe Supabase settings (the VITE_ prefix makes these available to the UI).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend (Flask)
FLASK_DEBUG=0
API_PORT=8000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key
TROJAN_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
TROJAN_INGESTION_API_KEY=replace-with-a-long-random-secret

# Backend URL used by the Wazuh messenger
TROJAN_API_URL=http://localhost:8000

# Wazuh Integration
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=change-me
WAZUH_API_PASSWORD=change-me

# AI Inference Engine
AI_ENGINE_PORT=8001
TF_CPP_MIN_LOG_LEVEL=2

# Groq API (if using)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Suricata
SURICATA_EVE_LOG=/var/log/suricata/eve.json
