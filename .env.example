
# Database
DB_USER=devuser
DB_PASSWORD=change-me
DB_NAME=trojan_db

# Backend (Flask/FastAPI)
FLASK_DEBUG=1
API_PORT=8000

# React Frontend (use VITE_API_URL instead if the project uses Vite)
REACT_APP_API_URL=http://localhost:8000

# Redis
REDIS_URL=redis://redis:6379

# Wazuh Integration
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=change-me
WAZUH_API_PASSWORD=change-me

# AI Inference Engine
AI_ENGINE_PORT=8001
TF_CPP_MIN_LOG_LEVEL=2

# Groq API (if using)
GROQ_API_KEY=your-groq-api-key-here

# Suricata
SURICATA_EVE_LOG=/var/log/suricata/eve.json

#Trojan api key
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Matches <api_key> in ossec.conf's <integration> block when Wazuh is running.
TROJAN_API_KEY=your_key_here
