#!/var/ossec/framework/python/bin/python3
"""Wazuh custom integration: send each alert to the Trojan backend.

Wazuh calls this as: custom-trojan <alert_file> <api_key> <hook_url>
The URL comes from <hook_url> in ossec.conf and defaults to the backend
service name on the shared Docker network.
"""
import json
import sys
import time
import urllib.error
import urllib.request

DEFAULT_URL = "http://backend:8000/v1/analyze"
LOG = "/var/ossec/logs/integrations.log"


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} custom-trojan: {msg}\n")


def main():
    if len(sys.argv) < 2:
        log("usage: custom-trojan <alert_file> [api_key] [hook_url]")
        return 1
    url = next((a for a in sys.argv[2:] if a.startswith("http")), DEFAULT_URL)
    api_key = next(
        (a for a in sys.argv[2:] if not a.startswith("http")), ""
    )
    with open(sys.argv[1]) as f:
        alert = json.load(f)
    rule_id = alert.get("rule", {}).get("id")
    body = json.dumps({"alerts": [alert]}).encode()
    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    req = urllib.request.Request(url, data=body, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            log(f"rule {rule_id} -> {url} HTTP {resp.status}")
    except urllib.error.URLError as e:
        log(f"rule {rule_id} -> {url} FAILED: {e}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
